# proximity_backend -- Edge Function secrets (Sprint 1 subset only).
# Set via `supabase secrets set --env-file .env` once a project exists.
# Never commit the real .env -- see ../.gitignore.

# Auto-provided inside every Supabase Edge Function at runtime -- do NOT set
# these manually when deploying; this file documents them for local (`deno
# task dev` / `supabase functions serve`) runs only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supavisor transaction-mode pooler connection string (port 6543), NOT the
# direct 5432 URL -- required inside Edge Functions, same as Baker Ally's
# backend_stack.md §6. Find it in Supabase Dashboard -> Project Settings ->
# Database -> Connection string -> "Transaction pooler".
DB_POOL_URL=

# CORS allowlist for /v1/shop/* and /v1/admin/* once those exist (Sprint
# 2+) -- proximity_web's deployed origin. Unset is fine for Sprint 1 since
# nothing here is browser-called yet.
ADMIN_WEB_ORIGIN=

# Sprint 8: Razorpay test-mode keys (lib/payments/razorpay.ts). KEY_ID is
# also handed to the Flutter app (its own .env, client-safe -- it's the
# public half of the key pair, same "anon key is meant to be public" shape
# as SUPABASE_ANON_KEY). KEY_SECRET signs order-creation requests and payment
# signatures server-side ONLY -- never send it anywhere, including logs.
# WEBHOOK_SECRET is a separate value, set once in the Razorpay Dashboard
# under Settings -> Webhooks alongside this Edge Function's webhook URL
# (.../api/v1/webhooks/razorpay) -- it is NOT the same secret as KEY_SECRET,
# a real, easy mix-up (razorpay.com/docs/webhooks/validate-test explains why
# they're deliberately different keys). When creating that webhook, the
# subscribed event MUST be `order.paid`, not `payment.captured` --
# lib/payments/razorpay.ts's own header explains why (payment.captured's
# payload has no order entity and can't carry this project's order_group_id
# note). All three are unset in this template because no real Razorpay
# account exists for this project yet -- see Sprint 8.md's "what's blocked
# on real credentials" section.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Which PaymentGateway lib/payments/index.ts hands back by default -- 'payu'
# is a stub (throws GATEWAY_NOT_IMPLEMENTED, §1.4/§11), so this should stay
# 'razorpay' until a real PayU integration exists. A config flag, not a
# rebuild, per §1.4's own stated goal for this abstraction.
PAYMENT_GATEWAY_DEFAULT=razorpay
