<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sprint 11: Android 13+ (API 33+) requires this as a runtime-granted
         permission before any notification (including FCM's) can actually
         show. FirebaseMessaging.instance.requestPermission()
         (push_service.dart) is what triggers the system prompt, but only if
         this is declared here first. firebase_messaging's own AAR manifest
         merges in its FirebaseMessagingService/receivers automatically
         (no google-services.json needed for that, see pubspec.yaml's own
         comment). This one permission line is the only manifest change
         this sprint needs.

         Sprint 13 fix: this comment used a doubled hyphen twice as a
         stylistic em dash substitute, the same convention used throughout
         this codebase's Dart/TS comments (harmless there). That sequence is
         never permitted inside an XML comment body, and this was a real,
         latent syntax error, never caught until this sprint's first actual
         Gradle build against a real device: ManifestMerger2 rejects it
         outright (org.xml.sax.SAXParseException, doubled hyphen not
         permitted within comments). Reworded rather than escaped, since an
         XML comment body cannot escape that sequence at all. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="proximity_app"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
