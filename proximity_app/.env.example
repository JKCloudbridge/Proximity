# proximity_app -- build-time config (envied). Copy to `.env`, fill in real
# values, never commit `.env` itself (see ../.gitignore).

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Points at the Edge Function's basePath, e.g.
# https://<ref>.supabase.co/functions/v1/api
API_BASE_URL=

# Google Sign-In (native, not the OAuth-redirect flow -- see
# auth_repository.dart's file header for why). GOOGLE_SERVER_CLIENT_ID must
# be a *Web* OAuth client from Google Cloud Console, not an Android/iOS one
# -- Supabase's signInWithIdToken checks the ID token's `aud` claim against
# the Google provider's configured client id, and only a Web client id is
# accepted there even though this is a mobile app. This trips people up
# constantly; it is not a typo.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=

# Apple Sign-In. iOS needs neither of these (native flow, uses the app's own
# bundle id/entitlement). Android and any future web build DO need both --
# sign_in_with_apple has no native OS-level Apple auth on Android, so it
# falls back to a Chrome Custom Tab web flow that requires a registered
# "Services ID" (a separate, web-facing client id from Apple Developer,
# NOT the app's bundle id) and a redirect URI your backend serves. Until
# these are set, Apple sign-in on Android will throw at call time --
# expected and harmless on iOS-only testing, see auth_repository.dart.
APPLE_SERVICE_ID=
APPLE_REDIRECT_URI=

# Sprint 8: no Razorpay key belongs in this file at all. The Razorpay key id
# (the public half of the pair -- safe client-side, same shape as
# SUPABASE_ANON_KEY above) is read from
# POST /v1/order-groups/:id/payment-order's own response instead
# (checkout_repository.dart's createPaymentOrder) -- proximity_backend
# already holds it server-side (its own .env's RAZORPAY_KEY_ID), so hardcoding
# a second copy of it here would just be a value this file could drift out of
# sync with. RAZORPAY_KEY_SECRET never belongs in this app at all, in any
# form -- it never leaves proximity_backend.

# Sprint 11: Firebase config, all client-safe (same "public half of a key
# pair" shape as SUPABASE_ANON_KEY -- none of these protect anything; FCM
# delivery is scoped by registration token, not by this config being
# secret). lib/core/push/push_service.dart passes these straight into
# Firebase.initializeApp(options: FirebaseOptions(...)) -- a manual init,
# deliberately not the FlutterFire-CLI/google-services.json path (that file's
# own header explains why; short version: no live Firebase project or
# `firebase login` session exists on this machine to run `flutterfire
# configure` against, and a half-added Gradle plugin with no json file to
# match would break the next Android build for a reason unrelated to any
# actual Dart code). Get all five from the Firebase console once a project
# exists: Project Settings -> General -> "Your apps" -> add an Android app
# AND an iOS app (same Firebase project, two different appId values) ->
# each app's own config snippet has apiKey/projectId/messagingSenderId/appId.
# Until these are set, push_service.dart's own init call throws at startup
# -- see that file's header for exactly how main.dart is expected to handle
# that (never let a missing Firebase config crash app startup outright).
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID_ANDROID=
FIREBASE_APP_ID_IOS=
