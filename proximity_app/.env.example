# proximity_app -- build-time config (envied). Copy to `.env`, fill in real
# values, never commit `.env` itself (see ../.gitignore).

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Points at the Edge Function's basePath, e.g.
# https://<ref>.supabase.co/functions/v1/api
API_BASE_URL=

# Google Sign-In (native, not the OAuth-redirect flow -- see
# auth_repository.dart's file header for why). GOOGLE_SERVER_CLIENT_ID must
# be a *Web* OAuth client from Google Cloud Console, not an Android/iOS one
# -- Supabase's signInWithIdToken checks the ID token's `aud` claim against
# the Google provider's configured client id, and only a Web client id is
# accepted there even though this is a mobile app. This trips people up
# constantly; it is not a typo.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=

# Apple Sign-In. iOS needs neither of these (native flow, uses the app's own
# bundle id/entitlement). Android and any future web build DO need both --
# sign_in_with_apple has no native OS-level Apple auth on Android, so it
# falls back to a Chrome Custom Tab web flow that requires a registered
# "Services ID" (a separate, web-facing client id from Apple Developer,
# NOT the app's bundle id) and a redirect URI your backend serves. Until
# these are set, Apple sign-in on Android will throw at call time --
# expected and harmless on iOS-only testing, see auth_repository.dart.
APPLE_SERVICE_ID=
APPLE_REDIRECT_URI=
